{
  "name": "hexagonal-cdk-starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "9.39.5",
    "@types/node": "22",
    "archunit": "2.5.4",
    "dependency-cruiser": "18.6.0",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint . --no-inline-config --max-warnings 0",
    "arch:cruise": "depcruise packages infra --config .dependency-cruiser.cjs",
    "arch:test": "vitest run --project arch",
    "arch:canary": "node scripts/canary.mjs",
    "test": "vitest run --project unit",
    "synth": "pnpm --filter @hex/infra synth",
    "verify": "node scripts/verify.mjs"
  }
}
